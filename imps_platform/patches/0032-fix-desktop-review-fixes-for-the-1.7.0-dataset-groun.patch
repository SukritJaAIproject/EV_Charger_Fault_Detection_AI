+    "source": "full_fleet",
+    "dataset": {"sessions": 1},
+    "leaderboard": [{"id": "agentic-ai", "rank": 1}],
+    "analysis": {"byStation": []},
+}
+
+
+class _JobServiceStub:
+    @staticmethod
+    def health() -> dict:
